MONGO_URL=mongodb://localhost:27017/household_os
# Optional: legacy bearer token, still honored by the API + used by the Alexa skill.
# Leave blank if you're only using the Google sign-in flow from the dashboard.
API_TOKEN=replace-me-with-a-long-random-string
# Optional: no longer required — persona chat happens on claude.ai now.
ANTHROPIC_API_KEY=

# Google Calendar (server-side, single-account OAuth — used by trigger ingestion
# and the Calendar / Schedule dashboard panels). Set up once locally with
# `npm -w @household-os/api run google-auth`, then upload both files to
# Render's Secret Files for production.
GOOGLE_CALENDAR_CREDENTIALS_PATH=./google-creds.json
GOOGLE_CALENDAR_TOKEN_PATH=./google-token.json
GOOGLE_CALENDAR_ID=primary

# Browser-side Google sign-in (login wall on the deployed dashboard).
# Create a separate OAuth 2.0 Client ID of type "Web application" in Google
# Cloud Console with the dashboard origins listed under both
# "Authorized JavaScript origins" and "Authorized redirect URIs":
#   http://localhost:5173
#   https://<your-dashboard>.onrender.com
GOOGLE_OAUTH_CLIENT_ID=
# Comma-separated email allowlist. Anyone signing in with a Google account
# whose email isn't in this list gets 403'd. Defaults to refusing everyone.
AUTH_ALLOWED_EMAIL=diane.stephani@gmail.com
# Signing secret for the short-lived session JWT issued after a successful
# Google sign-in. Required when GOOGLE_OAUTH_CLIENT_ID is set. >=16 chars.
JWT_SECRET=

ALEXA_SKILL_ID=amzn1.ask.skill....
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
# Set to 1 only for local mock testing — disables Alexa request signature verification.
# Real dev with ngrok keeps verification on (Alexa signs with their cert; ngrok forwards headers intact).
# ALEXA_SKIP_VERIFY=1
TZ=America/Los_Angeles
