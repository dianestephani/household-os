# Vite reads its env vars from this file (apps/dashboard/.env). Copy to .env
# and fill in your local values. All VITE_-prefixed vars are bundled into the
# client build, so they are public — never put secrets here.

# Where the API lives. In local dev with `npm run dev:dashboard`, Vite proxies
# /api → http://localhost:3000 (see vite.config.ts), so this can stay as-is.
# In production set it to your Render API URL, e.g.
#   https://household-os-api.onrender.com/api
VITE_API_BASE=/api

# Legacy static bearer token (matches API_TOKEN on the API service). Only used
# when you've NOT set up the Google sign-in flow. Once GOOGLE_OAUTH_CLIENT_ID
# is configured server-side and the user signs in, the dashboard uses the
# returned session token instead and this is ignored.
VITE_API_TOKEN=

# Google OAuth Client ID for the browser sign-in screen. Must match
# GOOGLE_OAUTH_CLIENT_ID on the API. Leaving this blank skips the login wall
# entirely (dashboard goes straight to the data) — useful for local dev.
VITE_GOOGLE_OAUTH_CLIENT_ID=
